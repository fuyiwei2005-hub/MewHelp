LLM_BASE_URL=https://api.deepseek.com
# Use a model ID returned by python -m scripts.check_models.
LLM_MODEL=replace-with-available-model
LLM_API_KEY=replace-with-your-key
LLM_STRUCTURED_METHOD=json_mode
# Leave blank for providers that do not accept reasoning_effort.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
TOKEN_BUDGET=8192
MAX_OUTPUT_TOKENS=1024
TOKEN_MARGIN=512
MAX_SESSIONS=100
SESSION_TTL_SECONDS=1800
HEARTBEAT_SECONDS=15


# Database: replace both passwords locally, never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_PASSWORD=replace-with-app-password
MYSQL_USER=support
MYSQL_DATABASE=support
DATABASE_URL=mysql+asyncmy://support:replace-with-app-password@127.0.0.1:3307/support?charset=utf8mb4
FAQ_BACKEND=dense
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_ATTEMPTS=2
EMBEDDING_BASE_URL=http://127.0.0.1:18001/v1
EMBEDDING_MODEL=BAAI/bge-m3
# Filled by python -m scripts.download_model
EMBEDDING_REVISION=main
MILVUS_URI=http://127.0.0.1:19531
RETRIEVAL_TOP_K=3
RETRIEVAL_THRESHOLD=0.65

RERANKER_BASE_URL=http://127.0.0.1:18002

# Filled by python -m scripts.download_reranker
RERANKER_REVISION=main
# Calibrate on calibration split: python -m scripts.calibrate_hybrid --apply
RERANKER_THRESHOLD=0.3

# Chapters 5/6: use scripts.serve_workflow to enable Workflow explicitly.
WORKFLOW_ENABLED=false
CHECKPOINT_IMAGE=postgres:16-alpine
CHECKPOINT_PASSWORD=change-this-local-checkpoint-password
CHECKPOINT_DATABASE_URL=postgresql://checkpoint:change-this-local-checkpoint-password@127.0.0.1:16432/checkpoint
# Blank inherits LLM_MODEL; small-model escalation is opt-in.
# INTENT_MODEL=your-capable-model
# INTENT_SMALL_MODEL=your-small-model
INTENT_THRESHOLD=0.75
AGENT_MAX_STEPS=6
AGENT_TOKEN_BUDGET=24000
WORKFLOW_TIMEOUT_SECONDS=480

# Chapter 7: current-conversation memory. Declared window must not exceed upstream.
MODEL_CONTEXT_WINDOW=128000
MAX_USER_INPUT_TOKENS=2000
TOOL_RESULT_MAX_TOKENS=1200
TOOL_CALL_MAX_TOKENS=150
RERANK_TOP_K=10
EVIDENCE_CHUNK_TOKENS=250
SYSTEM_PREFIX_TOKENS=1050
SUMMARY_RESERVE_TOKENS=1000
CONTEXT_SAFETY_TOKENS=1000
HISTORY_TARGET_TURNS=32
STEADY_ROUND_TOKENS=2000
CJK_TOKEN_FACTOR=1.0
ASCII_CHARS_PER_TOKEN=4.0
CONTEXT_LOG_PATH=log/app.log
SUMMARY_WORKERS=1
SUMMARY_TIMEOUT_SECONDS=60
SUMMARY_MAX_ATTEMPTS=3
# MAX_AGENT_STEPS is the new alias for AGENT_MAX_STEPS. Do not set both.
# Demo: MODEL_CONTEXT_WINDOW=18000, MAX_OUTPUT_TOKENS=2000,
# MAX_USER_INPUT_TOKENS=2000, MAX_AGENT_STEPS=3,
# TOOL_RESULT_MAX_TOKENS=1200, RERANK_TOP_K=5.
