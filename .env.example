LLM_BASE_URL=https://api.deepseek.com
# Use a model ID returned by python -m scripts.check_models.
LLM_MODEL=replace-with-available-model
LLM_API_KEY=replace-with-your-key
LLM_STRUCTURED_METHOD=json_mode
# Leave blank for providers that do not accept reasoning_effort.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=60
TOKEN_BUDGET=8192
MAX_OUTPUT_TOKENS=1024
TOKEN_MARGIN=512
MAX_SESSIONS=100
SESSION_TTL_SECONDS=1800
HEARTBEAT_SECONDS=15


# Database: replace both passwords locally, never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_PASSWORD=replace-with-app-password
MYSQL_USER=support
MYSQL_DATABASE=support
DATABASE_URL=mysql+asyncmy://support:replace-with-app-password@127.0.0.1:3307/support?charset=utf8mb4
FAQ_BACKEND=keyword
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_ATTEMPTS=2
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_MODEL=BAAI/bge-m3
# Filled by python -m scripts.download_model
EMBEDDING_REVISION=main
MILVUS_URI=http://127.0.0.1:19530
RETRIEVAL_TOP_K=3
RETRIEVAL_THRESHOLD=0.35
